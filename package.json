{
  "name": "ai-voice-cloning-backend",
  "version": "1.0.0",
  "description": "Local AI Text-to-Speech and Voice Cloning Backend using Coqui XTTS-v2",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "postinstall": "npm install --prefix frontend && npm run build --prefix frontend"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.0",
    "prisma": "6.4.1"
  }
}
