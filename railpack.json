{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "20",
    "python": "3.11"
  },
  "buildAptPackages": [
    "...",
    "ffmpeg",
    "libsndfile1"
  ],
  "steps": {
    "install": {
      "commands": [
        "npm install",
        "python3 -m pip install -r requirements.txt"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "npm run build"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "...",
      "ffmpeg",
      "libsndfile1"
    ],
    "startCommand": "node server.js"
  }
}
