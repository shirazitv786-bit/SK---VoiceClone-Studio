# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Railway Database)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@roundhouse.proxy.rlwy.net:12345/railway?sslmode=require"

# Individual Connection Details
PGHOST="roundhouse.proxy.rlwy.net"
PGPORT="12345"
PGUSER="postgres"
PGPASSWORD="YOUR_PASSWORD"
PGDATABASE="railway"

# Frontend / CORS Origin
CLIENT_URL="http://localhost:5173"

# JWT Secret Key for Session Authentication
JWT_SECRET="your_long_random_jwt_secret_key_here"

# Superadmin Initial Credentials
SUPERADMIN_NAME="Super Administrator"
SUPERADMIN_EMAIL="admin@yourdomain.com"
SUPERADMIN_PASSWORD="your_strong_admin_password_here"

# Coqui Engine Settings
COQUI_TOS_AGREED="1"
PYTHON_PATH=""
