generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  plan           String          @default("Free")
  credits        Int             @default(2000)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  role           String          @default("user")
  status         String          @default("active")
  planType       String?         @default("Free") @map("plan_type")
  charactersLeft Int?            @default(2000) @map("characters_left")
  subscriptionEndDate DateTime?  @map("subscription_end_date")
  creditsExpiresAt    DateTime?  @map("credits_expires_at")
  generations    Generation[]
  manualPayments ManualPayment[]
  voices         Voice[]

  @@map("users")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Voice {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  filename     String
  category     String?
  language     String?
  languageCode String?
  gender       String?
  description  String?
  previewText  String?
  tags         String[]
  neuralVoice  String?
  isCustom     Boolean  @default(false)
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])

  @@map("voices")
}

model Generation {
  id             String    @id @default(uuid())
  userId         String?
  deviceId       String?
  text           String
  referenceVoice String
  audioUrl       String?
  speed          Float     @default(-8)
  pitch          Float     @default(-4)
  pause          Float     @default(0.22)
  charsUsed      Int       @default(0)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime? @map("expires_at")
  isExpired      Boolean   @default(false) @map("is_expired")
  user           User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([isExpired])
  @@map("generations")
}

model ManualPayment {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  planType      String   @map("plan_type")
  amount        String?
  transactionId String   @unique @map("transaction_id")
  screenshotUrl String?  @map("screenshot_url")
  senderNumber  String?  @map("sender_number")
  status        String   @default("pending")
  adminNotes    String?  @map("admin_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manual_payments")
}
